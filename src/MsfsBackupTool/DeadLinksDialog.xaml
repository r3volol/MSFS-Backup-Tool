<Window x:Class="MsfsBackupTool.DeadLinksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Links with a missing target" Width="920" Height="480" MinWidth="640" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13" Background="#F5F6F8">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                       Text="These add-on links weren't recreated because the folder they point to no longer exists."/>
            <TextBlock Foreground="#5F6B7A" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="If you moved those add-ons (for example, to a new drive letter), pick their new location and the link will be created there. Anything left unticked is skipped."/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Skip all" Margin="0,0,8,0" IsCancel="True"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Create selected links" Click="Create_Click"/>
        </StackPanel>
        <DataGrid x:Name="LinksGrid">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="36">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Link" Binding="{Binding Name}" Width="200" IsReadOnly="True"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="72" IsReadOnly="True"/>
                <DataGridTextColumn Header="Original target (missing)" Binding="{Binding OriginalTarget}" Width="*" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="New target" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="…" Padding="8,0" MinHeight="24" Margin="4,0,0,0" Click="Browse_Click"/>
                                <TextBox Text="{Binding NewTarget, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
