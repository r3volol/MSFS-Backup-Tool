<Window x:Class="MsfsBackupTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MSFS Backup Tool" Width="1080" Height="760" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#F5F6F8" FontSize="13">
    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" VerticalAlignment="Center" x:Name="RefreshButton"/>
            <StackPanel>
                <TextBlock Text="MSFS Backup Tool" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="Back up, move and restore your Community and WASM folders, including add-on links, so a sim reinstall doesn't mean reinstalling every add-on."/>
            </StackPanel>
        </DockPanel>

        <!-- Sim running warning -->
        <Border Grid.Row="1" x:Name="SimRunningBanner" Visibility="Collapsed" Background="{StaticResource WarnBg}"
                BorderBrush="#F5C27A" BorderThickness="1" CornerRadius="4" Padding="10,7" Margin="0,0,0,10">
            <TextBlock x:Name="SimRunningText" Foreground="{StaticResource WarnFg}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <TabControl Grid.Row="2" x:Name="Tabs" Padding="12">
            <!-- Backup / Move -->
            <TabItem Header="  Back up / Move  ">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,0,0,6" FontWeight="SemiBold" Text="Folders found on this PC"/>
                    <Grid Grid.Row="1">
                        <DataGrid x:Name="LocationsGrid">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="36">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Sim" Binding="{Binding SimName}" Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Version" Binding="{Binding StoreName}" Width="76" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Folder" Binding="{Binding FolderName}" Width="200" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Contents" Binding="{Binding Status}" Width="230" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Location" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="…" Padding="8,0" MinHeight="24" Margin="4,0,0,0"
                                                        Click="BrowseLocation_Click" ToolTip="Choose a different folder"/>
                                                <TextBox Text="{Binding Path, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding Path}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="NoInstallsText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="460"
                                   Text="No MSFS 2020 or 2024 install was found. Run the sim once so it creates UserCfg.opt, then click Refresh."/>
                    </Grid>

                    <DockPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Save backup to:" VerticalAlignment="Center" Width="110"/>
                        <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="BrowseDest_Click"/>
                        <TextBox x:Name="DestBox"/>
                    </DockPanel>

                    <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="True">
                        <Button x:Name="BackupButton" Style="{StaticResource PrimaryButton}" Content="Back up (copy)" Click="Backup_Click"/>
                        <Button x:Name="MoveButton" Content="Move out" Margin="10,0,0,0" Padding="18,8" Click="Move_Click"/>
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                   Text="Back up copies the folders and leaves the sim folders as they are. Move out makes the same copy, then deletes the originals once every file has been checked. Links are saved and recreated when you restore."/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Restore -->
            <TabItem Header="  Restore  ">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock DockPanel.Dock="Left" Text="Backup folder:" VerticalAlignment="Center" Width="110"/>
                        <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="BrowseBackup_Click"/>
                        <TextBox x:Name="BackupBox" KeyDown="BackupBox_KeyDown" LostFocus="BackupBox_LostFocus"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" x:Name="BackupInfoText" Margin="110,6,0,8" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                               Text="Choose a folder named &quot;MSFS Backup &lt;date&gt;&quot;."/>
                    <DataGrid Grid.Row="2" x:Name="RestoreGrid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Folder" Binding="{Binding Name}" Width="290" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Contents" Binding="{Binding Summary}" Width="190" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Restore to" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="…" Padding="8,0" MinHeight="24" Margin="4,0,0,0"
                                                    Click="BrowseRestoreTarget_Click" ToolTip="Choose a different destination"/>
                                            <TextBox Text="{Binding TargetPath, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding OriginalPathTip}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <CheckBox Grid.Row="3" x:Name="MoveBackCheck" Margin="0,10,0,0"
                              Content="Move files back instead of copying (faster when the backup is on the same drive; moved files leave the backup)"/>
                    <DockPanel Grid.Row="4" Margin="0,12,0,0">
                        <Button x:Name="RestoreButton" Style="{StaticResource PrimaryButton}" Content="Restore" Click="Restore_Click"/>
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                   Text="If anything already exists you'll be asked once what to do. Links whose target folder is gone can be re-pointed afterwards."/>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Progress -->
        <Border Grid.Row="3" Margin="0,12,0,0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="4" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="DetailText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="PhaseText" FontWeight="SemiBold" Text="Ready"/>
                    </DockPanel>
                    <ProgressBar x:Name="Bar" Height="8" Margin="0,6,0,4" Maximum="100" Foreground="{StaticResource Accent}"/>
                    <TextBlock x:Name="ItemText" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="CancelButton" Content="Cancel" Margin="12,0,0,0" VerticalAlignment="Center"
                        IsEnabled="False" Click="Cancel_Click"/>
            </Grid>
        </Border>

        <Expander Grid.Row="4" Header="Log" Margin="0,8,0,0" x:Name="LogExpander">
            <DockPanel Margin="0,6,0,0">
                <TextBlock DockPanel.Dock="Bottom" Margin="0,4,0,0">
                    <Hyperlink Click="OpenLogs_Click">Open log folder</Hyperlink>
                </TextBlock>
                <TextBox x:Name="LogBox" Height="150" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
            </DockPanel>
        </Expander>
    </Grid>
</Window>
